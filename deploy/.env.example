# Production environment for the EC2 stack.
#
#   cp deploy/.env.example deploy/.env    # then fill in, and never commit it
#
# Compose reads this with --env-file. Values set under `environment:` in
# docker-compose.yml (TRUSTED_PROXY_HOPS, REDIS_URL, ENVIRONMENT) are fixed by
# the topology and don't belong here.

# --- Core -------------------------------------------------------------------
# 32+ characters. Generate with: openssl rand -hex 32
# The app refuses to start in production if this is left at its default.
SECRET_KEY=

# Decouples data-at-rest encryption from SECRET_KEY, so SECRET_KEY can be
# rotated without making stored provider secrets undecryptable.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

DEBUG=false

# --- Database (RDS) ---------------------------------------------------------
# Use the RDS endpoint, not localhost. sslmode=require keeps the connection
# encrypted in transit; RDS supports it out of the box.
DATABASE_URL=postgresql://glamuser:CHANGEME@your-db.abc123.eu-west-1.rds.amazonaws.com:5432/glam_by_lynn?sslmode=require

# --- URLs and CORS ----------------------------------------------------------
FRONTEND_URL=https://glambylynn.com
# Comma-separated. Must include every origin the browser will call from.
ALLOWED_ORIGINS=https://glambylynn.com,https://www.glambylynn.com

# --- Google OAuth -----------------------------------------------------------
# The same client as the frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://glambylynn.com/api/auth/callback/google

# --- Email ------------------------------------------------------------------
# The app refuses to start in production with EMAIL_PROVIDER=console or a
# missing key, so order and booking mail can't silently fail to send.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
FROM_EMAIL=noreply@glambylynn.com

# Who can be made an admin. Comma-separated.
ADMIN_EMAILS=admin@glambylynn.com

# --- Storage ----------------------------------------------------------------
# Storage is NOT read from the environment at runtime: the provider and its
# credentials live (encrypted) in the site_settings table, written by the admin
# UI. These variables exist only to bootstrap a new deployment, before there is
# a frontend or an admin account to do it through:
#
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env \
#       run --rm api python -m app.db.configure_storage
#
# That writes them to the database once. You can blank them here afterwards —
# the database is the source of truth from then on, and the admin UI is where
# you change them.
#
# Prefer cloudinary or s3 over local: `local` writes into the container's
# volume, which survives a redeploy but not the instance being replaced.
STORAGE_PROVIDER=cloudinary

# Cloudinary (when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3 (when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_BUCKET_NAME=

# --- Observability (optional) -----------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO

# --- Runtime ----------------------------------------------------------------
# uvicorn worker processes. Two is sensible on a t3.small; roughly match vCPUs.
WEB_CONCURRENCY=2
# The entrypoint runs `alembic upgrade head` before serving. Set false on every
# container if you run more than one, and migrate once as a separate step.
RUN_MIGRATIONS=true
